        "title": {
          "default": null
        },
        "description": {
          "default": null
        },
        "rating": {
          "default": 0
        }
      }
    }
  },
  "marks": {
    "link": {
      "inclusive": true,
      "attrs": {
        "href": {
          "default": null
        },
        "target": {
          "default": "_blank"
        },
        "rel": {
          "default": "noopener noreferrer nofollow"
        },
        "class": {
          "default": "text-blue-600 hover:text-blue-800 cursor-pointer relative group"
        },
        "title": {
          "default": null
        },
        "noRichPreview": {
          "default": false
        }
      }
    },
    "bold": {},
    "code": {
      "excludes": "_",
      "code": true
    },
    "italic": {},
    "strike": {},
    "underline": {}
  }
